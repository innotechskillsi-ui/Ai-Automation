{
  "manifest_version": 3,
  "name": "MultiPost — Post Everywhere at Once",
  "version": "1.0",
  "description": "Write once. Post to Twitter/X, LinkedIn, Facebook, Instagram, Reddit & more — simultaneously.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://twitter.com/*",
        "*://x.com/*",
        "*://www.linkedin.com/*",
        "*://www.facebook.com/*",
        "*://www.instagram.com/*",
        "*://www.reddit.com/*",
        "*://www.tiktok.com/*",
        "*://studio.youtube.com/*"
      ],
      "js": ["injector.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
